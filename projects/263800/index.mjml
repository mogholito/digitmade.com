<mjml lang="fr">
  <mj-head>
    <mj-raw>
      <!--[if mso | IE]>
      <style>
          body * {
            mso-line-height-rule: exactly;
          }
          sup { font-size: 75%; line-height: 0; }
        </style>
      <![endif]-->
    </mj-raw>
    <mj-attributes>
      <mj-section background-color="#fff" padding-bottom="10px" padding-top="10px" />
      <mj-text align="left" color="#3A3A3A" css-class="no-hyphen" font-family="Arial,sans-serif" font-size="13.7px" line-height="20px" />
      <mj-table align="left" color="#3A3A3A" font-family="Arial,sans-serif" font-size="13.7px" line-height="20px" />
      <mj-button background-color="#3A3A3A" border-radius="0" font-family="Arial,sans-serif" font-size="16px" font-weight="700" />
      <mj-class name="sml" font-size="13px" line-height="17px" />
      <mj-class name="email_link" align="center" color="#6a6a6a" font-size="12px" line-height="1.4" />
    </mj-attributes>
    <mj-style> .hyphenate { -webkit-hyphens: auto; -ms-hyphens: auto; hyphens: auto; word-break: normal; overflow-wrap: normal; } .no-hyphens { -webkit-hyphens: none; -ms-hyphens: none; hyphens: none; } .copy { font-size: 12px; } .va-top { vertical-align: top; padding-bottom: 4px } .bullet { width: 15px; vertical-align: top; font-size: 16px; mso-line-height-rule: exactly; } .list { font-size: 13.7px; line-height: 20px; padding-bottom: 4px; mso-line-height-rule: exactly; } .facts-table table { border-collapse: collapse; margin-top: 4px; } </mj-style>
    <mj-style> @media only screen and (max-width: 600px) { .appleLinks a { color: #000000 !important; text-decoration: none !important; } .appleLinksWhite a { color: #ffffff !important; text-decoration: none !important; } .table-scroll { overflow-x: auto; overflow-y: hidden; width: calc(97vw - 100px); } .table-scroll table { width: 550px !important; } .img-center-on-sm { padding-left: 25px !important; padding-right: 25px !important; text-align: center !important; } .center-on-sm { padding-left: 15px !important; padding-right: 15px !important; } .center-on-sm div { text-align: center !important; } .center-on-sm table { margin: 0 auto !important; } .default-width-on-sm>table td { width: 100% !important; padding-right: 10px !important; padding-left: 10px !important; } .default-hpad-on-sm { padding-right: 25px !important; padding-left: 25px !important; } .subheading-on-sm td { width:auto !important; } } @media only screen and (max-width: 480px) {.border-bottom-on-sm table td { border-bottom:1px solid #C9BDEA; border-right: none !important; } .border-bottom-on-sm .td { padding:0 5px 10px 0 !important; } .fixed-height-150 table td { border-left:0 !important; border-right:0 !important; } } </mj-style>
    <mj-style inline="inline"> .rounded > table { border-collapse:separate; border-radius:5px; } .fixed-height-150 > table { height:150px !important; } .fixed-height-150 > table > tbody > tr > td { height:150px !important; } </mj-style>
  </mj-head>
  <mj-body background-color="#f5f5f5">
    <mj-section background-color="#f5f5f5" padding-bottom="0">
      <mj-column>
        <mj-text mj-class="email_link">Jeśli ta wiadomość e-mail nie wyświetla się poprawnie, <a style="text-decoration: none !important" href="#0" target="_blank"><span style="color:#6a6a6a; text-decoration:underline;">kliknij tutaj</span></a>.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding-top="0">
      <mj-column>
        <mj-image src="https://www.digitmade.com/projects/263800//img/header-group4.png" alt="Pomóż swoim pacjentom zadbać o aktualną ochronę" padding="0" />
      </mj-column>
    </mj-section>
    <!-- First Section -->
    <mj-section background-color="#ffffff">
      <mj-column>
        <!-- SubHeading -->
        <mj-text align="center" color="#54447F" font-size="11px" line-height="18px" font-weight="700" padding-bottom="2px"> COVID-19 NADAL EWOLUUJE </mj-text>
        <mj-image src="https://www.digitmade.com/projects/263800/img/subheading-line1.png" alt="" width="230px" padding="0" />
        <!-- Icon and Text Section -->
        <mj-table cellpadding="0" cellspacing="0" width="100%">
          <tr>
            <td width="32" style="line-height:100%; padding-right: 12px; vertical-align:middle;">
              <img src="https://www.digitmade.com/projects/263800//img/Frame-10-1.png" alt="" width="32" height="32" style="display:block; width:32px; height:32px; border:0;" />
            </td>
            <td style="border-left:1px solid #826FA9; padding-left:12px; font-family:Arial,sans-serif; font-size:13.7px; line-height:20px; color:#3A3A3A; vertical-align:middle;">COVID-19 nadal krąży i ewoluuje.<sup style="font-size:70%; line-height:0; vertical-align:super; mso-text-raise:4px;">1,2</sup></td>
          </tr>
        </mj-table>
        <mj-table cellpadding="0" cellspacing="0" width="100%">
          <tr>
            <td width="32" style="line-height:100%; padding-right: 12px; vertical-align:middle;">
              <img src="https://www.digitmade.com/projects/263800//img/Frame-10-2.png" alt="" width="32" height="32" style="display:block; width:32px; height:32px; border:0;" />
            </td>
            <td style="padding-left:12px; border-left:1px solid #826FA9; padding-left:12px; font-family:Arial,sans-serif; font-size:13.7px; line-height:20px; color:#3A3A3A; vertical-align:middle;">Warianty SARS-CoV-2 są nadal monitorowane.</td>
          </tr>
        </mj-table>
        <mj-table cellpadding="0" cellspacing="0" width="100%">
          <tr>
            <td width="32" style="line-height:100%; padding-right: 12px; vertical-align:middle;">
              <img src="https://www.digitmade.com/projects/263800//img/Frame-10-3.png" alt="" width="32" height="32" style="display:block; width:32px; height:32px; border:0;" />
            </td>
            <td style="padding-left:12px; border-left:1px solid #826FA9; padding-left:12px; font-family:Arial,sans-serif; font-size:13.7px; line-height:20px; color:#3A3A3A; vertical-align:middle;">COVID-19 nadal może prowadzić do ciężkiego przebiegu choroby, szczególnie u osób starszych oraz osób z chorobami przewlekłymi lub obniżoną odpornością.<sup style="font-size:70%; line-height:0; vertical-align:super; mso-text-raise:4px;">3</sup></td>
          </tr>
        </mj-table>
        <mj-table cellpadding="0" cellspacing="0" width="100%">
          <tr>
            <td width="32" style="line-height:100%; padding-right: 12px; vertical-align:middle;">
              <img src="https://www.digitmade.com/projects/263800//img/Frame-10-4.png" alt="" width="32" height="32" style="display:block; width:32px; height:32px; border:0;" />
            </td>
            <td style="line-height:100%; padding:0; border-left:1px solid #826FA9; padding-left:12px; font-family:Arial,sans-serif; font-size:13.7px; -c-height:20px; color:#3A3A3A; vertical-align:middle;">Sezonowe szczepienia przeciw COVID-19 pozostają istotnym elementem profilaktyki w populacjach o zwiększonym ryzyku.</td>
          </tr>
        </mj-table>
        <!-- SubHeading 2 -->
        <mj-text align="center" color="#54447F" font-size="11px" line-height="18px" font-weight="700" padding-bottom="2px"> PACJENCI KWALIFIKUJĄCY SIĘ </mj-text>
        <mj-image src="https://www.digitmade.com/projects/263800/img/subheading-line2.png" alt="" width="170px" padding="0" />
        <mj-text align="center" color="#3C2F6E" font-weight="700" font-size="18px" line-height="22px" padding-bottom="0">Pacjenci wymagający szczególnej uwagi</mj-text>
        <mj-text align="center">Zwróć szczególną uwagę na poniższe grupy pacjentów podczas rozmowy o szczepieniu przeciw COVID-19.</mj-text>
      </mj-column>
    </mj-section>
    <!-- 3 columns section -->
    <mj-section padding-top="0">
      <mj-column border-right="1px solid #C9BDEA">
        <mj-image src="https://www.digitmade.com/projects/263800//img/icon01.png" alt="" width="100px" padding="0px" />
        <mj-text align="center" color="#2A1A6E" font-size="15px" line-height="20px" padding="0">Osoby starsze</mj-text>
        <mj-text align="center" font-size="12px" line-height="18px">Osoby starsze mogą być bardziej narażone na ciężki przebieg COVID-19.<sup style="font-size:70%; line-height:0; vertical-align:super; mso-text-raise:4px;">3</sup></mj-text>
      </mj-column>
      <mj-column border-right="1px solid #C9BDEA">
        <mj-image src="https://www.digitmade.com/projects/263800//img/icon02.png" alt="" width="100px" padding="0px" />
        <mj-text align="center" color="#2A1A6E" font-size="15px" line-height="20px" padding="0">Pacjenci z chorobami przewlekłymi</mj-text>
        <mj-text align="center" font-size="12px" line-height="18px">Choroby przewlekłe mogą zwiększać ryzyko ciężkiego przebiegu COVID-19.<sup style="font-size:70%; line-height:0; vertical-align:super; mso-text-raise:4px;">3</sup></mj-text>
      </mj-column>
      <mj-column>
        <mj-image src="https://www.digitmade.com/projects/263800//img/icon03.png" alt="" width="100px" padding="0px" />
        <mj-text align="center" color="#2A1A6E" font-size="15px" line-height="20px" padding="0">Osoby z obniżoną odpornością</mj-text>
        <mj-text align="center" font-size="12px" line-height="18px">Osoby z obniżoną odpornością są bardziej narażone na ciężki przebieg choroby.<sup style="font-size:70%; line-height:0; vertical-align:super; mso-text-raise:4px;">3</sup></mj-text>
      </mj-column>
    </mj-section>
    <!-- 2 columns section -->
    <mj-section padding-top="0">
      <mj-column width="16%"></mj-column>
      <mj-column width="33%" border-right="1px solid #C9BDEA">
        <mj-image src="https://www.digitmade.com/projects/263800//img/icon04.png" alt="" width="100px" padding="0px" />
        <mj-text align="center" color="#2A1A6E" font-size="15px" line-height="20px" padding="0">Kobiety w ciąży</mj-text>
        <mj-text align="center" font-size="12px" line-height="18px">Kobiety w ciąży mogą być bardziej narażone na ciężki przebieg COVID-19.<sup style="font-size:70%; line-height:0; vertical-align:super; mso-text-raise:4px;">4</sup></mj-text>
      </mj-column>
      <mj-column width="33%">
        <mj-image src="https://www.digitmade.com/projects/263800//img/icon05.png" alt="" width="100px" padding="0px" />
        <mj-text align="center" color="#2A1A6E" font-size="15px" line-height="20px" padding-top="0" padding-bottom="0">Pracownicy ochrony zdrowia / opiekunowie</mj-text>
        <mj-text align="center" font-size="12px" line-height="18px">Pracownicy ochrony zdrowia / opiekunowie.</mj-text>
      </mj-column>
      <mj-column width="16%"></mj-column>
    </mj-section>
    <!-- Text box 1 -->
    <mj-wrapper background-color="#FFFFFF" padding="0 25px">
      <mj-section background-color="#F4F2F9" border-radius="5px" css-class="rounded">
        <mj-column>
          <mj-table cellpadding="0" cellspacing="0" width="100%">
            <tr>
              <td width="35" style="line-height:100%; padding-right: 12px; vertical-align:middle;">
                <img src="https://www.digitmade.com/projects/263800//img/icon-shield.png" alt="" width="35" height="35" style="display:block; width:35px; height:35px; border:0;" />
              </td>
              <td style="padding:0; border-left:1px solid #826FA9; padding-left:12px; font-family:Arial,sans-serif; font-size:12px; line-height:18px; color:#3A3A3A; vertical-align:middle;">Ostateczne brzmienie kryteriów kwalifikacji musi być zgodne z zatwierdzonymi zaleceniami dla Polski na dany sezon.</td>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <!-- Vaccinating banner -->
    <mj-wrapper background-color="#FFFFFF" padding="0 25px">
      <mj-section>
        <mj-column width="40%">
          <!-- SubHeading 4 -->
        <mj-text align="left" color="#54447F" font-size="11px" line-height="18px" font-weight="700" padding-bottom="2px" padding-left="0"> GRYPA + COVID-19 </mj-text>
        <mj-image src="https://www.digitmade.com/projects/263800/img/subheading-line3.png" alt="" width="170px" padding="0" align="left" />
          <mj-text color="#3C2F6E" font-weight="700" font-size="18px" line-height="22px" padding="10px 0 0">Ochrona podczas jednej wizyty</mj-text>
          <mj-text font-size="12px" line-height="17px" padding-left="0" padding-bottom="0"> Szczepionki przeciw COVID-19 i grypie mogą być podane podczas tej samej wizyty, jeśli istnieją wskazania do obu szczepień.<sup style="font-size:70%; line-height:0; vertical-align:super; mso-text-raise:4px;">6</sup>
          </mj-text>
          <mj-text font-size="12px" line-height="17px" padding-left="0">
            <strong>Każda rozmowa o szczepieniu przeciw grypie jest również okazją do sprawdzenia statusu szczepienia przeciw COVID-19.</strong>
          </mj-text>
        </mj-column>
        <mj-column width="60%">
          <mj-image src="https://www.digitmade.com/projects/263800//img/vaccinating.png" alt="" align="center" padding="0" />
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <!-- 4 blocks -->
    <mj-wrapper background-color="#FFFFFF" padding="0 25px">
      <mj-section padding="0">
        <mj-column css-class="fixed-height-150" vertical-align="middle" width="50%" background-color="#47407E" padding="0px 10px" border-right="5px solid white">
          <mj-table cellpadding="0" cellspacing="0" width="100%" padding-left="45px">
            <tr>
              <td width="24" valign="middle" style="line-height:100%; padding-right:8px;">
                <img src="https://www.digitmade.com/projects/263800//img/bulb.png" alt="" width="24" height="24" style="display:block; width:24px; height:24px; border:0;" />
              </td>
              <td style="font-family:Arial,sans-serif; font-size:14px; line-height:18px; font-weight:700; color:#FFFFFF; text-transform:uppercase; letter-spacing:0.2px;">CZY WIESZ, ŻE?</td>
            </tr>
          </mj-table>
          <mj-text align="center" color="#FFFFFF" font-size="12px" line-height="18px" padding="5px 0 0 0"> Aktualne szczepienie przeciw COVID-19 pozostaje ważnym elementem ochrony pacjentów, szczególnie tych o zwiększonym ryzyku ciężkiego przebiegu choroby.<sup style="font-size:70%; line-height:0; vertical-align:super; mso-text-raise:4px;">5,6</sup>
          </mj-text>
        </mj-column>
        <mj-column css-class="fixed-height-150" vertical-align="middle" width="50%" background-color="#F6F4FD" padding="0px 10px" border-left="5px solid white">
          <mj-text color="#47407E" font-size="16px" line-height="20px" font-weight="700" padding="0" align="center">65+</mj-text>
          <mj-text align="center" color="#3A3A3A" font-size="12px" line-height="18px" padding="12px 0 0 0"> Osoby starsze, w tym osoby w wieku 65 lat i więcej, są bardziej narażone na ciężki przebieg COVID-19.<sup style="font-size:70%; line-height:0; vertical-align:super; mso-text-raise:4px;">3</sup>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding-top="0">
        <mj-column css-class="fixed-height-150" vertical-align="middle" width="50%" background-color="#F6F4FD" padding="0px 10px" border-right="5px solid white">
          <mj-text color="#47407E" font-size="16px" line-height="20px" font-weight="700" padding="0" align="center">WIEK MA ZNACZENIE</mj-text>
          <mj-text align="center" color="#3A3A3A" font-size="12px" line-height="18px" padding="12px 0 0 0"> Ryzyko hospitalizacji związanej z COVID-19 wzrasta wraz z wiekiem.<sup style="font-size:70%; line-height:0; vertical-align:super; mso-text-raise:4px;">3</sup>
          </mj-text>
        </mj-column>
        <mj-column css-class="fixed-height-150" vertical-align="middle" width="50%" background-color="#F6F4FD" padding="0px 10px" border-left="5px solid white">
          <mj-text color="#47407E" font-size="16px" line-height="20px" font-weight="700" padding="0" align="center">CIĘŻKI PRZEBIEG CHOROBY</mj-text>
          <mj-text align="center" color="#3A3A3A" font-size="12px" line-height="18px" padding="12px 0 0 0"> Osoby starsze pozostają szczególnie narażone na ciężki przebieg COVID-19.<sup style="font-size:70%; line-height:0; vertical-align:super; mso-text-raise:4px;">3,4</sup>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <!-- Text box 2 -->
    <mj-wrapper background-color="#FFFFFF" padding="15px 25px 0">
      <mj-section css-class="rounded" background-color="#F4F2F9" border-radius="5px">
        <mj-column vertical-align="middle" width="55%">
          <mj-table css-class="border-bottom-on-sm" cellpadding="0" cellspacing="0" width="100%" padding="5px 10px">
            <tr>
              <td width="35" style="line-height:100%; padding-right: 12px; vertical-align:middle;">
                <img src="https://www.digitmade.com/projects/263800//img/frame301.png" alt="" width="35" height="35" style="display:block; width:35px; height:35px; border:0;" />
              </td>
              <td class="td" style=" border-right:1px solid #C9BDEA; padding:0 5px 0 0; font-family:Arial,sans-serif; font-size:12px; line-height:18px; color:#3A3A3A; vertical-align:middle;">
                <div style="color:#2B1B6B;margin-bottom:4px;"><strong>Przygotuj się już dziś z myślą o zdrowszym jutrze.</strong></div>Planowanie z wyprzedzeniem może pomóc chronić większą liczbę pacjentów, gdy rozpocznie się sezon.
              </td>
            </tr>
          </mj-table>
        </mj-column>
        <mj-column vertical-align="middle" width="45%">
          <mj-table cellpadding="0" cellspacing="0" width="100%" padding="5px 10px">
            <tr>
              <td width="35" style="line-height:100%; padding-right: 12px; vertical-align:middle;">
                <img src="https://www.digitmade.com/projects/263800//img/frame302.png" alt="" width="35" height="35" style="display:block; width:35px; height:35px; border:0;" />
              </td>
              <td style="padding:0; font-family:Arial,sans-serif; font-size:12px; line-height:18px; color:#2B1B6B; vertical-align:middle;"><strong>Ostateczne brzmienie kryteriów kwalifikacji musi być zgodne z zatwierdzonymi zaleceniami dla Polski na dany sezon.</strong></td>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section background-color="#FFFFFF" padding-bottom="0">
      <mj-column>
        <!-- SubHeading 5 -->
        <mj-text align="center" color="#54447F" font-size="11px" line-height="18px" font-weight="700" padding-bottom="2px"> TWÓJ WPŁYW NA ZDROWIE PUBLICZNE W POLSCE </mj-text>
        <mj-image src="https://www.digitmade.com/projects/263800/img/subheading-line4.png" alt="" width="280px" padding="0" />
        <mj-text align="center" color="#3C2F6E" font-weight="700" font-size="18px" line-height="22px" padding-bottom="0">Twoja rekomendacja ma znaczenie</mj-text>
        <mj-text align="center">Pracownicy ochrony zdrowia odgrywają kluczową rolę w informowaniu o sezonowych szczeieniach przeciw grypie i COVID-19 oraz w ochronie pacjentów, którzy najbardziej jej potrzebują.</mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper background-color="#FFFFFF" padding-top="0" padding-bottom="0">
      <mj-section background-color="#ffffff" padding-top="0">
        <mj-column>
          <mj-table cellspacing="0" cellpadding="0" width="100%" padding-bottom="0">
            <tr>
              <td style="width:155px; font-family:Arial,sans-serif; font-size:10.5px; line-height:14px; color:#5B3596; font-weight:700; text-align:left; vertical-align:middle;">JAKI MOŻESZ MIEĆ WPŁYW</td>
              <td style="line-height:100%; vertical-align:middle; width:auto;">
                <img src="https://www.digitmade.com/projects/263800//img/subheading-line.png" alt="" width="400" align="center" style="display:inline-block; vertical-align:middle; border:0px; max-width:100%" />
              </td>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>
      <mj-section padding-top="0">
        <mj-column width="50%" border-right="1px solid #C9BDEA">
          <mj-image src="https://www.digitmade.com/projects/263800//img/twoja1.png" alt="" width="41px" />
          <mj-text align="center" color="#2A1A6E" font-size="14px" line-height="16px" font-weight="700" padding="0">REKOMENDUJ</mj-text>
          <mj-text align="center" font-size="12px" line-height="18px">Rozpoczynaj rozmowy na temat szczepień przeciw grypie i COVID-19 z pacjentami kwalifikującymi się do szczepienia.</mj-text>
        </mj-column>
        <mj-column width="50%">
          <mj-image src="https://www.digitmade.com/projects/263800//img/twoja2.png" alt="" width="41px" />
          <mj-text align="center" color="#2A1A6E" font-size="14px" line-height="16px" font-weight="700" padding="0">DOSTOSUJ REKOMENDACJĘ</mj-text>
          <mj-text align="center" font-size="12px" line-height="18px">Dostosuj rekomendację do wieku, stanu zdrowia i czynników ryzyka każdego pacjenta.</mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding-top="0">
        <mj-column width="50%" border-right="1px solid #C9BDEA">
          <mj-image src="https://www.digitmade.com/projects/263800//img/twoja1.png" alt="" width="41px" />
          <mj-text align="center" color="#2A1A6E" font-size="14px" line-height="16px" font-weight="700" padding="0">ROZWIEWAJ WĄTPLIWOŚCI</mj-text>
          <mj-text align="center" font-size="12px" line-height="18px">Odpowiadaj na pytania i wątpliwości pacjentów, pomagając budować zaufanie do szczepień.</mj-text>
        </mj-column>
        <mj-column width="50%">
          <mj-image src="https://www.digitmade.com/projects/263800//img/twoja2.png" alt="" width="41px" />
          <mj-text align="center" color="#2A1A6E" font-size="14px" line-height="16px" font-weight="700" padding="0">DZIAŁAJ</mj-text>
